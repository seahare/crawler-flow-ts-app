{
  "name": "crawler-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Visual crawler orchestration tool for developers",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev -w @crawl/server",
    "dev:frontend": "npm run dev -w @crawl/frontend",
    "dev": "npm-run-all --parallel dev:server dev:frontend"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}
